{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netplane.dev/schema/v1/topology.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "NetplaneTopologyGraph",
  "type": "object",
  "required": ["generated_at", "root_ids", "nodes", "edges"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "root_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "online"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["device", "client"] },
          "role": { "type": "string" },
          "driver": { "type": "string" },
          "label": { "type": "string" },
          "mac": { "type": "string" },
          "ip": { "type": "string" },
          "online": { "type": "boolean" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from_id", "to_id", "kind", "evidence", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "from_id": { "type": "string" },
          "from_link": { "type": "string" },
          "to_id": { "type": "string" },
          "to_link": { "type": "string" },
          "kind": { "type": "string", "enum": ["wired", "lag", "wireless_uplink", "wireless_client"] },
          "evidence": {
            "type": "string",
            "enum": ["lldp", "fdb_unique", "fdb_inferred", "wireless_uplink", "wireless_client"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "speed_mbps": { "type": "integer", "minimum": 0 },
          "member_links": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
